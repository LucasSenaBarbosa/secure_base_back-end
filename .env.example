# SecureBase backend environment template
# Copy this file to .env and replace placeholders with the values for the active environment.
# Never commit .env or any real secret.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# Supabase project used by the backend.
# For local development, use the URL and secret key reported by `supabase status`.
# For production, use the URL and secret API key of its dedicated Supabase project.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-local-supabase-secret-key
SUPABASE_TIMEOUT_SECONDS=5

# SecureBase authentication secrets.
# Always use a strong random value of at least 32 characters.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_SECONDS=2592000
